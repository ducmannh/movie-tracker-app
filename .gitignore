# ====================================================================
# MovieTracker - Git Ignore Configuration (.gitignore)
# Dành cho dự án Fullstack: .NET Core Web API + React/Vite/TypeScript
# ====================================================================

# --------------------------------------------------------------------
# 1. .NET & C# (MovieTrackerBE)
# --------------------------------------------------------------------
# Thư mục build output và binary compiled
bin/
obj/
[Bb]in/
[Oo]bj/
out/

# Visual Studio temporary files, user specific files
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates

# NuGet packages & Publish outputs
*.nupkg
packages/
*.publishproj
[Tt]est[Rr]esults/

# Crash dumps & Performance profiling
*.stackdump
*.vsp
*.vspx
*.sap

# --------------------------------------------------------------------
# 2. Node.js & React / Vite Frontend (MovieTrackerFE)
# --------------------------------------------------------------------
# Thư viện phụ thuộc (rất nặng, không đẩy lên Git)
node_modules/
.pnp
.pnp.js

# Build production bundle
dist/
dist-ssr/
build/

# Logs của npm, yarn, pnpm
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Biến môi trường local (chứa secret hoặc config cá nhân)
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# --------------------------------------------------------------------
# 3. IDEs & Text Editors
# --------------------------------------------------------------------
# Visual Studio Code (giữ lại cấu hình dùng chung nếu có)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (Rider, WebStorm, IntelliJ)
.idea/
*.DotSettings.user

# Sublime Text / Atom / Vim
*.swp
*.swo
*~

# --------------------------------------------------------------------
# 4. Database & Backups
# --------------------------------------------------------------------
*.mdf
*.ldf
*.ndf
*.bak
*.sqlproj.user

# --------------------------------------------------------------------
# 5. Hệ điều hành (OS generated files)
# --------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# --------------------------------------------------------------------
# 6. AI Agent & Scratch Files
# --------------------------------------------------------------------
.gemini/
.agents/
