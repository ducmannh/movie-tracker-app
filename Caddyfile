{
    # Tắt quản lý admin API nội bộ
    admin off

    # TẮT TOÀN BỘ TỰ ĐỘNG CHUYỂN HƯỚNG HTTPS (Khắc phục triệt để lỗi ERR_TOO_MANY_REDIRECTS khi dùng Cloudflare Tunnel)
    auto_https off
}

# Lắng nghe duy nhất HTTP cổng 80, không redirect HTTPS
:80 {
    # 1. Chuyển tiếp toàn bộ API về Backend .NET Web API
    handle /api/* {
        reverse_proxy backend:5032 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    # 2. (Tùy chọn) Cho phép xem Swagger UI nếu cần test trên server
    handle /swagger/* {
        reverse_proxy backend:5032
    }

    # 3. Chuyển tiếp toàn bộ giao diện web về Frontend React (Nginx)
    handle {
        reverse_proxy frontend:80
    }

    # Ghi log truy cập
    log {
        output stdout
        format console
    }
}
